//ARSALLOC JOB (ACCT),'ALLOCATE DATA SETS',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*------------------------------------------------------------------*
//* ARSALLOC - ONE-TIME SETUP FOR THE ARSENAL GOALS JOBS.            *
//*                                                                  *
//* CREATES THE LIBRARIES AND DATA SETS. RUN IT ONCE, THEN UPLOAD    *
//* THE SOURCE, COPYBOOKS, PROCS AND DATA INTO THEM (SEE README).    *
//*                                                                  *
//* BEFORE SUBMITTING: CHANGE EVERY "YOURID" TO YOUR OWN HIGH-LEVEL  *
//* QUALIFIER (USUALLY YOUR USER ID).                                *
//*                                                                  *
//* IEFBR14 IS IBM'S "DO NOTHING" PROGRAM. THE WORK HAPPENS IN THE   *
//* DD STATEMENTS: DISP=(NEW,CATLG) CREATES AND CATALOGS EACH ONE.   *
//*------------------------------------------------------------------*
//ALLOC    EXEC PGM=IEFBR14
//*
//* LIBRARIES OF 80-BYTE CARD IMAGES (PDSE: DSNTYPE=LIBRARY)
//SOURCE   DD DSN=YOURID.ARSENAL.SOURCE,DISP=(NEW,CATLG,DELETE),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,SPACE=(TRK,(5,5,5))
//COPYLIB  DD DSN=YOURID.ARSENAL.COPYLIB,DISP=(NEW,CATLG,DELETE),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,SPACE=(TRK,(5,5,5))
//PROCLIB  DD DSN=YOURID.ARSENAL.PROCLIB,DISP=(NEW,CATLG,DELETE),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,SPACE=(TRK,(5,5,5))
//*
//* LOAD LIBRARY. ENTERPRISE COBOL 5 AND LATER BUILD PROGRAM
//* OBJECTS, WHICH MUST LIVE IN A PDSE (DSNTYPE=LIBRARY).
//LOADLIB  DD DSN=YOURID.ARSENAL.LOADLIB,DISP=(NEW,CATLG,DELETE),
//            DSNTYPE=LIBRARY,RECFM=U,BLKSIZE=32760,
//            SPACE=(TRK,(15,15,5))
//*
//* SEASON DATA: FIXED-LENGTH RECORDS MATCHING THE COPYBOOKS
//MATCHES  DD DSN=YOURID.ARSENAL.MATCHES.D2526,DISP=(NEW,CATLG,DELETE),
//            RECFM=FB,LRECL=80,SPACE=(TRK,(1,1))
//GOALS    DD DSN=YOURID.ARSENAL.GOALS.D2526,DISP=(NEW,CATLG,DELETE),
//            RECFM=FB,LRECL=100,SPACE=(TRK,(1,1))
